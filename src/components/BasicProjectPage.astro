---
import Basic from "../components/BasicPage.astro";
import thumbsup from "../media/bunger/FTRookie_thumbsup.png";
import "../styles/projectpage.css";
const {
    title = "FtRookie",
    favicon = thumbsup,
    hero = `FtRookie's ${title}`,
} = Astro.props;
---

<Basic title={title} hero={hero} favicon={favicon}>
    <a class="naventry" href="/projects"> &#60; Back </a>
    <slot />
</Basic>
<script is:inline data-astro-rerun>
    document.querySelector(".navbar").style.display = "none";
</script>
