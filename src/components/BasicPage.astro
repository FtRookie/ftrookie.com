---
import { Picture } from "astro:assets";
import Head from "./Head.astro";
import "../styles/global.css";
import thumbsup from "../media/FTRookie_thumbsup.png";
export const partial = true;

const {
    title = "FtRookie",
    favicon = thumbsup,
    header = `FtRookie's ${title}`,
} = Astro.props;
---

<html lang="en_US" transition:name="root" transition:animate="slide">
    <head>
        <title>{title}</title>
        <link rel="icon" type="image/png" href={favicon.src} />
        <meta charset="utf-8" />
        <script src="../scripts/theme.js"></script>
        <script is:inline>
            document.addEventListener("astro:before-swap", (event) => {
                const theme = localStorage.getItem("theme");
                event.newDocument.documentElement.dataset.theme = theme
                    ? theme
                    : "dark";
            });
        </script>
        <Head />
    </head>
    <body>
        <button
            transition:animate="none"
            id="theme-toggle"
            onclick=`const currentTheme = document.documentElement.getAttribute('data-theme');
                    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-theme', newTheme);
                    localStorage.setItem('theme', newTheme);`
            >&#127769</button
        >
        <!--due for removal when i create my own-->
        <h1 id="header" transition:animate="none">
            {header}
            <Picture src={favicon} alt="thinker" />
        </h1>
        <slot />
        <a class="credits" href="https://i3ym.ru"
            >Thanks to i3ym for making this possible
        </a>
        <footer class="credits">
            I host this website on my old PC, it might be slow
        </footer>
        <footer class="credits">
            Portions of this website were written with the assistance of LLMs
        </footer>
        <a class="credits" href="mailto:email@ftrookie.com">
            email@ftrookie.com
        </a>
    </body>
</html>
