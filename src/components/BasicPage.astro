---
import { Picture } from "astro:assets";
import Head from "./Head.astro";
import Thinker from "../media/FTRookie_think.png";
import "../styles/global.css";
export const partial = true;

const { title = "FtRookie's Website", favicon = "/thumbsup.png" } = Astro.props;
---

<html lang="en_US" transition:name="root" transition:animate="slide">
    <head>
        <title>{title}</title>
        <link rel="icon" type="image/png" href={favicon} />
        <meta charset="utf-8" />
        <script src="../scripts/theme.js"></script>
        <script is:inline>
            document.addEventListener("astro:before-swap", (event) => {
                const theme = localStorage.getItem("theme");
                event.newDocument.documentElement.dataset.theme = theme
                    ? theme
                    : "dark";
            });
        </script>
        <Head />
    </head>
    <body>
        <button
            id="theme-toggle"
            onclick=`const currentTheme = document.documentElement.getAttribute('data-theme');
                    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-theme', newTheme);
                    localStorage.setItem('theme', newTheme);`
            >&#127769</button
        >
        <!--due for removal when i create my own-->
        <h1 id="header">
            FtRookie's Website
            <Picture src={Thinker} alt="thinker" />
        </h1>
        <slot />
    </body>
</html>
