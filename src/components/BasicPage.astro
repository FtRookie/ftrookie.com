---
import { Picture } from "astro:assets";
import Head from "./Head.astro";
import "../styles/global.css";
import thumbsup from "../media/bunger/FTRookie_thumbsup.png";
export const partial = true;

const {
    title = "FtRookie",
    favicon = thumbsup,
    hero = `FtRookie's ${title}`,
} = Astro.props;
---

<html lang="en_US" transition:name="root" transition:animate="slide">
    <head>
        <title>{title}</title>
        <link rel="icon" type="image/png" href={favicon.src} />
        <meta charset="utf-8" />
        <script src="../scripts/theme.ts"></script>
        <script
            src="https://kit.fontawesome.com/fba9df0135.js"
            is:inline
            data-astro-rerun></script>
        <Head />
    </head>
    <body>
        <div id="viewport">
            <button
                transition:animate="none"
                id="theme-toggle"
                onclick=`const currentTheme = document.documentElement.getAttribute('data-theme');
                    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                    document.documentElement.setAttribute('data-theme', newTheme);
                    localStorage.setItem('theme', newTheme);`
                >&#127769</button
            >
            <!--due for removal when i create my own-->
            <div id="hero" transition:animate="none">
                <h1>{hero}</h1>
                <Picture src={favicon} loading={"eager"} alt={favicon.src} />
            </div>
            <div class="navbar" transition:animate="none">
                <a href="/home">Home</a>
                <a href="/gallery">Gallery</a>
                <a href="/projects">Projects</a>
                <a href="/likes">Likes</a>
                <a href="/socials">Socials</a>
                <a href="/artists">Artists</a>
            </div>
            <slot />
            <div class="credits" transition:animate="fade">
                <a href="https://i3ym.ru">
                    Thanks to i3ym for making this possible
                </a>
                <footer>
                    I host this website on my old PC, it might be slow
                </footer>
                <footer>
                    Portions of this website were written with the assistance of
                    LLMs
                </footer>
            </div>
        </div>
    </body>
</html>
