---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	author: string;
	song: string;
	image: ImageMetadata;
	/** Optional small caption shown under the title. */
	description?: string;
}

const { author, song, image, description } = Astro.props;
---

<li class="album">
	<div>
		<Image src={image} alt={`${author} - ${song}`} loading="lazy" />
		<div class="album-text">
			<h2>
				{author} - {song}
			</h2>
			{description && <p class="album-description">{description}</p>}
		</div>
	</div>
</li>
