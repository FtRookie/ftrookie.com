---
import { Image } from "astro:assets";
const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/media/albumcovers/*.{json,jpg,png,gif}",
);
const { author = "", song = "", image = "" } = Astro.props;
const imageModule = await images[`/src/media/albumcovers/${image}`]?.();
---

<li class="album">
    <div>
        {imageModule && <Image src={imageModule.default} alt={`${author} - ${song}`} loading="lazy" />}
        <h2>{author} - {song}</h2>
    </div>
</li>
