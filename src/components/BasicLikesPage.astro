---
import Basic from "../components/BasicPage.astro";
import thumbsup from "../media/bunger/FTRookie_thumbsup.png";
const {
    title = "FtRookie",
    favicon = thumbsup,
    header = `FtRookie's ${title}`,
    url = Astro.url.pathname,
} = Astro.props;
---

<script is:inline data-astro-rerun>
    document.querySelector(".navbar").style.display = "none";
</script>
<Basic title={title} header={header} favicon={favicon}>
    <a class="naventry" href="../likes">&#60; Back</a>
    <slot />
</Basic>
