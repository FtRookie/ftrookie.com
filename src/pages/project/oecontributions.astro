---
import Basic from "../../components/BasicPage.astro";
import LightboxBar from "../../components/LightboxBar.astro";
import PlaneCrazy from "../../media/PlaneCrazyThumbnail.png";
import PlaneEngineersThumbnail from "../../media/PlaneEngineersThumbnail.png";
import PlaneEngineersBanner from "../../media/PlaneEngineersBanner.png";
import Blocksworld from "../../media/Blocksworld.png";
import DMCA1 from "../../media/DMCA1.png";
import DMCA4 from "../../media/DMCA4.png";
import "../../styles/oecontributions.css";
import "../../styles/projectpage.css";
import { marked } from "marked";

const md = (s: string) => marked.parse(s) as string;

const prose = {
    origins: md(
        `As an engineering-aligned creative, I started out playing games like Blocksworld, a sandbox building game,
        at a young age. Similarly on the Roblox platform,
        I found Plane Crazy, and played it for a very long time.
        I have 2400 hours on it as of today. Disillusioned with the state of the game and the lack of updates,
        I decided to move on from Plane Crazy.`,
    ),
    findingPE: md(
        `I got bored one day and decided to look on the Roblox discover page.
        I found a game called Plane Engineers,
        decided to try it and I found the flight and impact destruction physics to be very fun.
        Furthermore, I discovered that the game had a logic system that allowed for control systems,
        and that is when I fell in love with the game.`,
    ),
    involvement: md(
        `As a committed player with a lot of sandbox experience and a lot of feedback,
        I was very vocal in the community and garnered a reputation, soon becoming a tester.
        I quickly befriended the developers, **Maks_gaming**, **i3ym**, and **samlovebutter**.
        By request, created a plane tutorial which was then adopted into the game.`,
    ),
    dmca: md(
        `**Maks**, originally the developer of *Build A Plane To Crash (BAPTC)*,
        used public Toolbox assets from Roblox Studio in order to create BAPTC,
        including using Rickje's assets which were accidentally published to Toolbox.
        **Rickje139**, the developer of *Plane Crazy*, got *Plane Engineers* taken down through a DMCA claim.
        He claimed that Plane Engineers infringed on his copyright because of 'stolen assets' from Plane Crazy.
        Plane Engineers was the successor to *BAPTC*, but shares **<u>no framework</u>** with *BAPTC*,
        the games were not even written in the same language, with *BAPTC* being in <u>Lua</u>,
        and *Plane Engineers* being in <u>Typescript</u> respectively.`,
    ),
    downtime: md(
        `Players complained about the down time, which was a full 14 days to dispute each claim.
        At first, the developers opened *Test Engineers* to the public, but shortly after,
        *Test Engineers* was taken down with a DMCA claim.
        After several takedowns, the developers started reuploading the game from different accounts
        since their original accounts were banned because of the claims.`,
    ),
    openSource: md(
        `The developers made the decision to make the game Open Sourced,
        allowing players to contribute.<br /><br />Previously,
        I never worked on anything other than my own personal projects in Roblox Studio written in Lua.
        In contrast, Overengineered was written in Typescript and managed via Github.
        Working on Overengineered was what taught me how to use Github and create pull requests.
        **i3ym** specifically, provided me with a lot of guidance through many of the issues with my
        [first PR](https://github.com/anywaymachines/overengineered/pull/8).`,
    ),
    nowWhat: md(
        `As the <u>decision was made to give up on the Roblox platform</u>,
        the game repository was archived and no longer uploaded to the platform.
        I have stopped my contributions, and the developers are currently working on an off-platform sequel,
        free from **Rickje139**'s abuse of the Roblox DMCA system'.
        As of now, the details of the new game are unknown and the basic framework of the game is being laid out,
        but it is not even guaranteed that they will finish the sequel.`,
    ),
};

const originImages = [
    { image: Blocksworld, alt: "Blocksworld", title: "Blocksworld" },
    { image: PlaneCrazy, alt: "Plane Crazy", title: "Plane Crazy" },
];

const peImages = [
    {
        image: PlaneEngineersThumbnail,
        alt: "PE Thumbnail",
        title: "Original Plane Engineers Thumbnail",
    },
    {
        image: PlaneEngineersBanner,
        alt: "PE Banner",
        title: "Plane Engineers Banner",
    },
];

const dmcaImages = [
    {
        image: DMCA1,
        alt: "1st DMCA Claim",
        title: "First DMCA",
        description:
            "The first fraudulent DMCA claim used to take down Plane Engineers",
    },
    {
        image: DMCA4,
        alt: "2nd DMCA Claim",
        title: "Fourth DMCA",
        description:
            "Test Engineers was taken down after it opened to the public",
    },
];
---

<Basic title="OE Contributions" favicon="judgment" backHref="/projects">
    <div id="content">
        <h2 class="chapterheader">Origins</h2>
        <Fragment set:html={prose.origins} />

        <LightboxBar images={originImages} height="250px" />

        <h2 class="chapterheader">Finding Plane Engineers</h2>
        <Fragment set:html={prose.findingPE} />
        <LightboxBar images={peImages} height="300px" />
        <h2 class="chapterheader">Initial Involvement</h2>
        <Fragment set:html={prose.involvement} />
        <iframe
            width="560"
            height="315"
            src="https://www.youtube.com/embed/t3BecB7mwgc"
            title="YouTube video player"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"
            style="margin-top:1.5rem;"
        >
        </iframe>
        <footer>maks changed aero and the plane is kil</footer>
        <h2 class="chapterheader">DMCA Takedowns</h2>
        <Fragment set:html={prose.dmca} />
        <br />
        <Fragment set:html={prose.downtime} />
        <LightboxBar images={dmcaImages} />
        <h2 class="chapterheader">Learning How to Contribute</h2>
        <Fragment set:html={prose.openSource} />
        <h2 class="chapterheader">Now What?</h2>
        <Fragment set:html={prose.nowWhat} />
    </div>
    <div id="info">
        <a href="https://github.com/anywaymachines">Original Developers</a>
        <a href="https://github.com/anywaymachines/overengineered">
            Original Repository (Archive)
        </a>
        <a href="https://github.com/FtRookie/overengineered">My Fork</a>
        <h2>Things I contributed</h2>
        <ul>
            <li>Propellant Blocks</li>
            <li>Tracer Block</li>
            <li>Proximity Scanner/Emitter</li>
            <li>Laser Block Range Extension</li>
            <li>Scale Block &#127820</li>
            <li>Different seat blocks</li>
            <li>Lamp Shapes</li>
            <li>
                <a
                    href="https://github.com/anywaymachines/overengineered/pulls?q=author%3AFtRookie"
                >
                    various other things
                </a>
            </li>
        </ul>
    </div>
</Basic>
<script src="../../scripts/oecontributions.ts"></script>
