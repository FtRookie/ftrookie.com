---
import { Picture } from "astro:assets";
import BasicProjectPage from "../../components/BasicProjectPage.astro";
import BungsUp from "../../media/FTRookie_thumbsup.png";
import saywhaaat from "../../media/saywhat.png";
import insanity from "../../media/insanity.png";
---

<style>
    #insanity {
        width: 30%;
        height: auto;
    }
</style>

<BasicProjectPage title="Website" favicon={BungsUp}>
    <p>Self-hosted website with a CI/CD workflow</p>
    <p>Git deployed with self-hosted runner and deploy action</p>
    <p>Registered and proxied with Cloudflare</p>
    <br />
    <h2>Made with...</h2>
    <ul>
        <li>
            <a href="https://astro.build/">Astro</a>
        </li>
        <li>
            <a href="https://biati-digital.github.io/glightbox/">Glightbox</a>
        </li>
        <li>
            <a href="https://fontawesome.com">fontawesome</a>
        </li>
        <li><a href="https://nginx.org/">nginx</a></li>
        <li><a href="https://certbot.eff.org/">certbot</a></li>
    </ul>
    <br />
    <p>The server is ran on my old PC using a debian linux installation</p>
    <p>Specs: i5-4670k, 8gb ddr3 1666mhz, 256GB SSD</p>
    <Picture src={saywhaaat} alt="saywhaaat" />
    <footer>feeble creature</footer>
    <h2>brute force</h2>
    <Picture id="insanity" src={insanity} alt="insanity" />
</BasicProjectPage>
