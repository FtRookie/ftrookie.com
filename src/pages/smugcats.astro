---
import Basic from "@/components/BasicPage.astro";
import LightboxCaption from "@/components/LightboxCaption.astro";
import PlaceholderImage from "@/components/PlaceholderImage.astro";
import { getImage, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import "@/styles/smugcats.css";

const images = import.meta.glob<{ default: ImageMetadata }>("/src/media/smugcats/*.{jpg,jpeg,png,gif,webp,avif}");

//fixme: poopy in-file format helper
const prettify = (path: string): string =>
	path
		.split("/")
		.pop()!
		.replace(/\.[^.]+$/, "")
		.replace(/[-_]+/g, " ")
		.replace(/\b\w/g, (c) => c.toUpperCase());

// Optional lightbox descriptions, keyed by filename in src/media/smugcats/.
const descriptions = {
	// "start-doing-this.png": "description shown under the title",
} satisfies Record<string, string>;

const smugcats = await Promise.all(
	Object.keys(images)
		.sort()
		.map(async (path) => {
			const image = (await images[path]!()).default;
			const full = await getImage({
				src: image,
				format: image.format === "gif" ? "gif" : "webp",
			});
			return {
				image,
				title: prettify(path),
				// `satisfies` infers only the keys present, so widen it for lookup by any filename.
				description: (descriptions as Record<string, string | undefined>)[path.split("/").pop()!],
				src: full.src,
				width: image.width,
				height: image.height,
			};
		}),
);
---

<Basic title="Smug Cats" hero="Smug Cats" favicon="judgment">
	<h2>I love smug ass cats</h2>
	<footer>not my cats or images</footer>
	<br />
	{smugcats.length > 0 ? (
		<ul id="smugcats">
			{smugcats.map(({ image, title, description, src, width, height }) => (
				<li>
					<a href={src} data-pswp-width={width} data-pswp-height={height} class="lightbox">
						<Picture src={image} alt={title} loading="lazy" />
						<LightboxCaption title={title} description={description} />
					</a>
				</li>
			))}
		</ul>
	) : (
		<div id="smugcats-empty">
			<p>No smug cats yet. Check back later.</p>
			<PlaceholderImage />
		</div>
	)}
</Basic>
<script src="@/scripts/smugcats.ts"></script>
