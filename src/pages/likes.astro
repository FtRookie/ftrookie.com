---
import { Picture, Image } from "astro:assets";
import Basic from "../components/BasicPage.astro";
import thumbsup from "../media/bunger/FTRookie_thumbsup.png";
import "../styles/projects.css";
import RageDoge from "../media/ragedoge.gif";
import CatJam from "../media/catjam.gif";
import AngryCat from "../media/angrycatlaptop.gif";
import Nerd from "../media/nerd.png";
---

<Basic title="Likes" favicon={thumbsup}>
    <h2>some things I like to do</h2>
    <div style="display:flex;flex-direction:column;">
        <article class="project">
            <a href="/likes/gaming">
                <Image src={RageDoge} alt="ragedoge" loading={"eager"} />
                <div style="display:inline;margin:auto">
                    <h2>Gaming</h2>
                    <p>I play a lot of video games</p>
                </div>
            </a>
        </article>
        <article class="project">
            <a href="/likes/musictastes">
                <Picture
                    src={CatJam}
                    alt="music"
                    loading={"eager"}
                    style="object-fit: cover;"
                />
                <div style="display:inline;margin:auto">
                    <h2>Music Tastes</h2>
                    <p>I listen to lots of different types of music</p>
                </div>
            </a>
        </article>
        <article class="project">
            <a href="/likes/coding">
                <Image
                    src={AngryCat}
                    alt="angrycatlaptop"
                    loading={"eager"}
                    style="object-fit: cover;"
                />
                <div style="display:inline;margin:auto">
                    <h2>Coding</h2>
                    <p>I don't do it too often but I guess it's okay</p>
                </div>
            </a>
        </article>
        <article class="project">
            <a href="/likes/pcbuilding">
                <Picture src={Nerd} alt="nerd" loading={"eager"} />
                <div style="display:inline;margin:auto">
                    <h2>PC Building</h2>
                    <p>
                        I built my own computer and like to discuss PC hardware
                    </p>
                </div>
            </a>
        </article>
    </div>
</Basic>
