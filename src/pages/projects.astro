---
import { Picture } from "astro:assets";
import Basic from "../components/BasicPage.astro";
import Thumbsup from "../media/bunger/FTRookie_thumbsup.png";
import Judgment from "../media/bunger/FTRookie_judge.png";
import "../styles/projects.css";
import type { ImageMetadata } from "astro";

interface Project {
    title: string;
    blurb: string;
    href: string;
    image: ImageMetadata | string;
    alt: string;
}

const projects: Project[] = [
    {
        title: "This Website",
        blurb: "the very website that you are visiting right now!",
        href: "/project/website",
        image: Thumbsup,
        alt: "thumbsup",
    },
    {
        title: "OverEngineered (Contributor)",
        blurb: "A defunct open-source Roblox sandbox game",
        href: "/project/oecontributions",
        image: "https://avatars.githubusercontent.com/u/171940191?s=200&v=4",
        alt: "anywaymachines",
    },
];
---

<Basic title="Projects" favicon={Judgment}>
    <p>durrrrr</p>
    <div style="display:flex;flex-direction:column;">
        {
            projects.map(({ title, blurb, href, image, alt }) => (
                <article class="project">
                    <a href={href}>
                        {typeof image === "string" ? (
                            <img src={image} alt={alt} />
                        ) : (
                            <Picture src={image} alt={alt} />
                        )}
                        <div style="display:inline;margin:auto">
                            <h2>{title}</h2>
                            <p>{blurb}</p>
                        </div>
                    </a>
                </article>
            ))
        }
    </div>
</Basic>
