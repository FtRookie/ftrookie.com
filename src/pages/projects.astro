---
import { Picture } from "astro:assets";
import Basic from "../components/BasicPage.astro";
import Thumbsup from "../media/FTRookie_thumbsup.png";
import Judgment from "../media/FTRookie_judge.png";
import "../styles/projects.css";
---

<Basic title="Projects" favicon={Judgment}>
    <div class="navbar">
        <a href="home">Homepage</a>
        <a href="gallery">Gallery</a>
        <a href="likes">Likes</a>
        <a href="socials">Socials</a>
        <a href="artists">Artists</a>
    </div>
    <p>durrrrr</p>
    <div style="display:div;flex-direction:column;">
        <article class="project">
            <Picture src={Thumbsup} alt="thumbsup" />
            <div style="display:inline;margin:auto">
                <a href="/project/website">This Website</a>
                <p>the very website that you are looking at right now!</p>
            </div>
        </article>
        <article class="project">
            <img
                src="https://avatars.githubusercontent.com/u/171940191?s=200&v=4"
                alt="anywaymachines"
            />
            <div style="display:inline;margin:auto">
                <a href="/project/oecontributions"
                    >OverEngineered (Contributor)
                </a>
                <p>A defuct open-source Roblox sandbox game</p>
            </div>
        </article>
    </div>
</Basic>
