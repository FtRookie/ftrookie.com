---
import { Picture } from "astro:assets";
import Basic from "@/components/BasicPage.astro";
import { bungers } from "@/scripts/bunger";
import { remoteImage } from "@/scripts/buildFetch";
import { robloxGameIcon, UNDERENGINEERED_UNIVERSE_ID } from "@/scripts/roblox";
import "@/styles/projects.css";
import type { ImageMetadata } from "astro";
import saywhaaat from "@/media/saywhat.png";

interface Project {
	title: string;
	blurb: string;
	href: string;
	image: ImageMetadata | string;
	alt: string;
}

const projects = [
	{
		title: "This Website",
		blurb: "the very website that you are visiting right now!",
		href: "/project/website",
		image: bungers.thumbsup,
		alt: "thumbsup",
	},
	{
		title: "OverEngineered (Contributor)",
		blurb: "A defunct open-source Roblox sandbox game",
		href: "/project/oecontributions",
		image: await remoteImage(
			"anywaymachines GitHub avatar",
			async () => "https://avatars.githubusercontent.com/u/171940191?s=200&v=4",
		),
		alt: "anywaymachines",
	},
	{
		title: "Underengineered (Fork)",
		blurb: "An unofficial continuation of OverEngineered",
		href: "/project/underengineered",
		image: await remoteImage("Underengineered Roblox icon", () => robloxGameIcon(UNDERENGINEERED_UNIVERSE_ID)),
		alt: "Gundam",
	},
	{
		title: "OPERATORS",
		blurb: "Coming soon",
		href: "/project/OPERATORS",
		image: saywhaaat,
		alt: "OPERATORS",
	},
] satisfies Project[];
---

<Basic title="Projects" favicon="judgment">
	<p>durrrrr</p>
	<div style="display:flex;flex-direction:column;">
		{projects.map(({ title, blurb, href, image, alt }) => (
			<article class="project">
				<a href={href}>
					{typeof image === "string" ? (
						<Picture src={image} alt={alt} inferSize loading={"eager"} />
					) : (
						<Picture src={image} alt={alt} loading={"eager"} />
					)}
					<div style="display:inline;margin:auto">
						<h2>{title}</h2>
						<p>{blurb}</p>
					</div>
				</a>
			</article>
		))}
	</div>
</Basic>
