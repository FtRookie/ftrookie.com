---
import Basic from "../components/BasicPage.astro";
import { Picture } from "astro:assets";
import Judgment from "../media/bunger/FTRookie_judge.png";
import Yippee from "../media/bunger/yippee.png";
import Rowenrizz from "../media/bunger/rowenrizz.png";
import reference from "../media/fortuneisacat.jpg";
import blehh from "../media/blehh.gif";
import "../styles/home.css";
import thinker from "../media/bunger/FTRookie_think.png";
---

<Basic title="FtRookie's Website" hero="FtRookie's Website" favicon={thinker}>
   <div id="clankerprompt" style="display:none">
      <Picture
         src={Judgment}
         alt="Judgment"
         loading={"eager"}
         layout="full-width"
      />
      <h1>Are you a clanker?</h1>
      <div>
         <button id="clankeryes" type="button">Yes I'm a dirty RAM eater</button
         >
         <button id="clankerno" type="button"
            >No I'm a carbon based lifeform</button
         >
      </div>
   </div>
   <div id="content">
      <h2 style="display:inline-block">Who am I?</h2>
      <div>
         <p>I am the bunger, you will be bungled</p>
         <br />
         <Picture
            class="yippee"
            src={Yippee}
            alt="roweniee"
            loading={"eager"}
         />
      </div>
      <div>
         <p>It's finished!!!</p>
         <div>
            <Picture
               class="yippee"
               src={Rowenrizz}
               alt="rizznetre"
               loading={"eager"}
               style="width:40%;aspect-ratio:1;height:auto;object-fit:contain;"
            />
            <Picture
               src={reference}
               alt="fortuneisacat"
               loading={"eager"}
               style="width:40%;aspect-ratio:1;height:auto;object-fit:contain;"
            />
         </div>
      </div>
      <Picture
         src={blehh}
         alt="freaky"
         loading={"eager"}
         style="display:block"
      />
   </div>
   <div id="info">
      <h2>Species:</h2>
      <p>Domestic Cat / Furred Dragon (Hybrid)</p>
      <h2>Birthday:</h2>
      <p>December 29</p>
      <h2>Gender:</h2>
      <p>Cisgender Male (he/him)</p>
      <h2>Country and current time:</h2>
      <p>
         United States
         <img class="icon" src="/USFlag.svg" alt="🇺🇸" />
      </p>
      <p id="timenow"></p>
      <h2>How to address me:</h2>
      <p>
         &#10004 Rook <br />
         &#10004 Rookie <br />
         &#10004 Bung <br />
         &#10004 Bunger <br />
         &#10006 FtRookie (sounds awkward) <br />
         &#10006 F T (sounds stupid)<br />
      </p>
      <h2>Also known as:</h2>
      <p>
         Rookie5102<br />
         CrimeToHumanity<br />
      </p>
   </div>
</Basic>
<script src="../scripts/home.ts"></script>
