---
import Basic from "../components/BasicPage.astro";
import { Picture } from "astro:assets";
import Judgement from "../media/bunger/FTRookie_judge.png";
import Yippee from "../media/bunger/yippee.png";
import blehh from "../media/blehh.gif";
import didyouknow from "../media/didyouknow.gif";
import "../styles/home.css";
import thinker from "../media/bunger/FTRookie_think.png";
---

<Basic title="Website" favicon={thinker}>
   <div id="clankerprompt" style="display:none">
      <Picture
         src={Judgement}
         alt="JUDGEMENT"
         loading={"eager"}
         layout="full-width"
      />
      <h1>Are you a clanker?</h1>
      <div>
         <button
            id="clankeryes"
            onclick="window.location.replace('SHOOCLANKER');"
            type="button">Yes I'm a dirty RAM eater</button
         >
         <button
            id="clankerno"
            type="button"
            onclick="clankerprompt.style.display = 'none';"
            >No I'm a carbon based lifeform</button
         >
      </div>
   </div>
   <h2 style="display:inline-block">Who am I?</h2>
   <br />
   <p>I am the bunger, you will be bungled</p>
   <div id="info">
      <h2>Species:</h2>
      <p>Domestic Cat / Furred Dragon : Hybrid</p>
      <h2>Birthday:</h2>
      <p>December 29</p>
      <h2>Gender:</h2>
      <p>Cisgender Male (he/him)</p>
      <h2>Country and current time:</h2>
      <p>
         United States
         <img class="icon" src="/USFlag.svg" alt="🇺🇸" />
      </p>
      <p id="timenow"></p>
      <h2>How to address me:</h2>
      <p>
         &#10004 Rook <br />
         &#10004 Rookie <br />
         &#10004 Bung <br />
         &#10004 Bunger <br />
         &#10006 F T (you sound stupid)<br />
         &#10006 FtRookie (sounds awkward) <br />
      </p>
      <h2>Also known as:</h2>
      <p>
         Rookie5102<br />
         CrimeToHumanity<br />
      </p>
   </div>
   <br />
   <Picture id="yippee" src={Yippee} alt="roweniee" loading={"eager"} />
   <p>
      <br />
      poopoo peepee <br />
      mcstinky
      <Picture
         src={blehh}
         alt="freaky"
         loading={"eager"}
         style="display:block"
      />
      <Picture
         src={didyouknow}
         alt="didyouknow"
         style="display:block;max-width:50%;height:auto"
      />
   </p>
</Basic>
<script src="../scripts/home.js"></script>
