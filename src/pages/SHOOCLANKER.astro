---
import { Picture } from "astro:assets";
import Head from "../components/Head.astro";
import CLANKER from "../media/CLANKER.png";
---

<html lang="en_US">
    <style>
        img {
            position: fixed;
            left: 0;
            top: 0;
            display: block;
            height: 100vh;
            width: 100vw;
        }
    </style>

    <title>DIRTY CLANKER</title>
    <link
        rel="icon"
        type="Picture/x-icon"
        href="https://www.ftrookie.com/angry.png"
    />
    <Head />
    <body>
        <Picture src={CLANKER} alt="GO AWAY CLANKER" />
    </body>
</html>
