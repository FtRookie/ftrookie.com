---
import { Picture } from "astro:assets";
import Head from "../components/Head.astro";
import CLANKER from "../media/CLANKER.png";
---

<html lang="en">
    <head>
        <title>DIRTY CLANKER</title>
        <link rel="icon" type="image/png" href="/angry.png" />
        <Head />
        <style>
            img {
                position: fixed;
                left: 0;
                top: 0;
                display: block;
                height: 100vh;
                width: 100vw;
            }
        </style>
    </head>
    <body>
        <Picture src={CLANKER} alt="GO AWAY CLANKER" />
    </body>
</html>
