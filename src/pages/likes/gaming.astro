---
import { Picture } from "astro:assets";
import BasicLikesPage from "../../components/BasicLikesPage.astro";
import Thumbsup from "../../media/bunger/FTRookie_thumbsup.png";
import saywhaaat from "../../media/saywhat.png";
---

<BasicLikesPage title="Gaming" favicon={Thumbsup}>
    <div id="content">
        <h2>I like video games</h2>
        <p>
            I tend toward to play First-Person Shooters and military vehicle
            combat, although these aren't the only type of games I play
        </p>
    </div>
    <div id="info">
        <h2>some recent games i'm playing include:</h2>
        <ul>
            <li>
                <a href="https://store.steampowered.com/app/1422450/Deadlock/">
                    Deadlock
                </a>
            </li>
            <li>
                <a
                    href="https://store.steampowered.com/app/1144200/Ready_or_Not/"
                >
                    Ready or Not
                </a>
            </li>
            <li>
                <a
                    href="https://www.roblox.com/games/9503261072/ENGINEER-Tower-Defense-X-BETA"
                >
                    Tower Defense X (Roblox)
                </a>
            </li>
            <li>
                <a
                    href="https://store.steampowered.com/app/3643170/Roadside_Research/"
                >
                    Roadside Research
                </a>
            </li>
            <li>
                <a
                    href="https://store.steampowered.com/app/359550/Tom_Clancys_Rainbow_Six_Siege/"
                >
                    Rainbow Six Siege
                </a>
            </li>
            <li>
                <a
                    href="https://store.steampowered.com/app/236390/War_Thunder/"
                >
                    War Thunder
                </a>
            </li>
        </ul>
    </div>
    <Picture src={saywhaaat} alt="saywhaaat" />
</BasicLikesPage>
