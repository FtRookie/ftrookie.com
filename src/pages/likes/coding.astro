---
import { Picture } from "astro:assets";
import BasicLikesPage from "../../components/BasicLikesPage.astro";
import Judgment from "../../media/bunger/FTRookie_judge.png";
import saywhaaat from "../../media/saywhat.png";
---

<BasicLikesPage title="Coding" favicon={Judgment}>
    <div id="content">
        <h2>Coding isn't my favorite thing in the world, but I tolerate it</h2>
        <p>
            I like to be able to create things, and for that reason, coding is a
            great way to put ideas into practice with very little investment
            involved.
        </p>
        <p>
            I've experimented in a lot of ways, usually via Roblox Studio just
            trying to make the framework for a game, but can never find myself
            committing to it for very long.
        </p>
    </div>
    <div id="info">
        <h2>Some languages I have used <br />Most to Least used</h2>
        <ul>
            <li>Luau (Roblox)</li>
            <li>Python</li>
            <li>Javascript</li>
            <li>Typescript</li>
            <li>Java</li>
        </ul>
    </div>
    <Picture src={saywhaaat} alt="saywhaaat" />
</BasicLikesPage>
