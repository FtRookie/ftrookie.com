---
import { Picture } from "astro:assets";
import BasicLikesPage from "../../components/BasicLikesPage.astro";
import Judgment from "../../media/bunger/FTRookie_judge.png";
import saywhaaat from "../../media/saywhat.png";
---

<BasicLikesPage title="Music Taste" favicon={Judgment}>
    <div id="content">
        <h2>I listen to many different genres</h2>
        <p>
            I like to listen to activity-appropriate music, but also like just
            general listening, typically Pop music
        </p>
    </div>
    <div id="info">
        <h2>Some notable genres</h2>
        <ul>
            <li>2010s Pop</li>
            <li>EDM</li>
            <li>Funk Wav</li>
            <li>Rap</li>
            <li>Hardstyle/Hardbass</li>
            <li>Post-punk Rock</li>
        </ul>
        <h2>Musical artists/groups I like</h2>
        <ul>
            <li>Calvin Harris</li>
            <li>Daniel Caesar</li>
            <li>The Weeknd</li>
            <li>Bruno Mars</li>
            <li>Metro Boomin</li>
            <li>Kendrick Lamar</li>
            <li>Кино</li>
            <li>Otographic Music</li>
        </ul>
    </div>
    <Picture src={saywhaaat} alt="saywhaaat" />
</BasicLikesPage>
