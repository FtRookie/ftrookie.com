---
const ptpurl = new URL("/ptp", Astro.site);
const ptpimage = new URL("/ptp.gif", Astro.site);
const ptpdesc = "encuentra a un pendejo y mandaselo";
const ptpfull = "pTP5TeZ64uZuWHQUW08fXzLqbgx_s8ly";
---

<html lang="en">
    <head>
        <title>{ptpfull}</title>
        <link rel="icon" type="image/gif" href="/144ptp.gif" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={ptpdesc} />
        <meta property="og:url" content={ptpurl} />
        <meta property="og:title" content={ptpfull} />
        <meta property="og:description" content={ptpdesc} />
        <meta property="og:image" content={ptpimage} />
        <meta property="og:image:width" content="1125" />
        <meta property="og:image:height" content="724" />
        <meta name="twitter:card" content="summary_large_image" />
        <style>
            img {
                position: fixed;
                left: 0;
                top: 0;
                display: block;
                height: 100vh;
                width: 100vw;
            }
        </style>
    </head>
    <body>
        <img src="/ptp.gif" alt={ptpfull} />
    </body>
</html>
