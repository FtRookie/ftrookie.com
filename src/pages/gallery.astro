---
import Basic from "@/components/BasicPage.astro";
import LightboxCaption from "@/components/LightboxCaption.astro";
import { getImage, Picture } from "astro:assets";
import metadata from "@/media/bunger/metadata.json";
import { getCompleteCollection } from "@/scripts/collections";
import "@/styles/gallery.css";

const entries = (
	await getCompleteCollection(
		"bunger",
		metadata.map((m) => m.id),
	)
).sort((a, b) => b.data.date.localeCompare(a.data.date));
const galleryItems = await Promise.all(
	entries.map(async (entry) => ({
		...entry,
		full: await getImage({ src: entry.data.path, format: "webp" }),
	})),
);
---

<Basic title="Gallery" favicon="thumbsup">
	<div id="something">
		<div id="options">
			<button class="collapsible" type="button" id="sort-direction-button" data-type="numerical" data-order="up">
				sort direction:
				<i class="fa-solid fa-arrow-down-a-z" aria-hidden="true"></i>
				<i class="fa-solid fa-arrow-up-z-a" aria-hidden="true"></i>
				<i class="fa-solid fa-arrow-down-1-9" aria-hidden="true"></i>
				<i class="fa-solid fa-arrow-up-9-1" aria-hidden="true"></i>
			</button>
			<details class="option" id="collapsible-sort-by">
				<summary class="collapsible">
					<span id="label-sort-by">sort by: date</span>
					<i class="fa-solid fa-angle-right" aria-hidden="true"></i>
					<i class="fa-solid fa-angle-down" aria-hidden="true"></i>
				</summary>
				<div class="collapser"></div>
			</details>
			<details class="option" id="collapsible-filter-author">
				<summary class="collapsible">
					filter: author
					<i class="fa-solid fa-angle-right" aria-hidden="true"></i>
					<i class="fa-solid fa-angle-down" aria-hidden="true"></i>
				</summary>
				<div class="collapser"></div>
			</details>
			<details class="option" id="collapsible-filter-type">
				<summary class="collapsible">
					filter: type
					<i class="fa-solid fa-angle-right" aria-hidden="true"></i>
					<i class="fa-solid fa-angle-down" aria-hidden="true"></i>
				</summary>
				<div class="collapser"></div>
			</details>
		</div>
		<ul id="gallery">
			{galleryItems.map(({ id, data, full }) => (
				<li id={id}>
					<a
						href={full.src}
						data-pswp-width={full.attributes.width}
						data-pswp-height={full.attributes.height}
						class="lightbox"
					>
						<Picture
							src={data.path}
							alt={data.lightboxTitle}
							data-metadata-title={data.lightboxTitle}
							data-metadata-author={data.author}
							data-metadata-date={data.date}
							data-metadata-type={data.type}
						/>
						<LightboxCaption title={data.lightboxTitle} description={data.lightboxDescription} />
					</a>
				</li>
			))}
		</ul>
	</div>
</Basic>
<script src="@/scripts/gallery.ts"></script>
