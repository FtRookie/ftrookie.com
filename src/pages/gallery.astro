---
import Basic from "../components/BasicPage.astro";
import { Picture } from "astro:assets";
import "../styles/glightbox.min.css";
import "../styles/gallery.css";
import BungsUp from "../media/bunger/FTRookie_thumbsup.png";
import data from "../media/bunger/metadata.json";

const bungerImages = import.meta.glob<{ default: ImageMetadata }>(
    "/src/media/bunger/*.{png,gif}",
);

const galleryItems = await Promise.all(
    data.map(async (item) => {
        const mod = await bungerImages[`/src/media/bunger/${item.path}`]?.();
        return { ...item, image: mod?.default };
    })
);
---

<Basic title="Gallery" favicon={BungsUp}>
      <div id="something">
            <ul id="options">
                  <button
                        class="collapsible"
                        id="sort-direction-button"
                        data-type="numerical"
                        data-order="up"
                  >
                        sort direction:
                        <i class="fa-solid fa-arrow-down-a-z"></i>
                        <i class="fa-solid fa-arrow-up-z-a"></i>
                        <i class="fa-solid fa-arrow-down-1-9"></i>
                        <i class="fa-solid fa-arrow-up-9-1"></i>
                  </button>
                  <div class="option" id="collapsible-sort-by" data-state="collapsed">
                        <button class="collapsible">
                              <span id="label-sort-by">sort by: date</span>
                              <i class="fa-solid fa-angle-right"></i>
                              <i class="fa-solid fa-angle-down"></i>
                        </button>
                        <div class="collapser"></div>
                  </div>
                  <div class="option" id="collapsible-filter-author" data-state="collapsed">
                        <button class="collapsible">
                              filter: author
                              <i class="fa-solid fa-angle-right"></i>
                              <i class="fa-solid fa-angle-down"></i>
                        </button>
                        <div class="collapser"></div>
                  </div>
                  <div class="option" id="collapsible-filter-type" data-state="collapsed">
                        <button class="collapsible">
                              filter: type
                              <i class="fa-solid fa-angle-right"></i>
                              <i class="fa-solid fa-angle-down"></i>
                        </button>
                        <div class="collapser"></div>
                  </div>
            </ul>
            <ul id="gallery">
                  {galleryItems.map((item) => item.image && (
                        <li id={item.title}>
                              <a
                                    href={item.image.src}
                                    data-title={item.lightboxTitle}
                                    data-description={item.lightboxDescription}
                                    class="glightbox"
                              >
                                    <Picture src={item.image} alt={item.lightboxTitle} />
                              </a>
                        </li>
                  ))}
            </ul>
      </div>
</Basic>
<script src="../scripts/glightbox.min.js"></script>
<script src="../scripts/gallery.ts"></script>
