---
import Head from "../components/Head.astro";
import { Picture } from "astro:assets";
import Thinker from "../media/FTRookie_think.png";
import "../styles/global.css";
---

<style>
    h1 {
        text-align: center;
        font-size: 600%;
    }
    p {
        text-align: center;
        font-size: 300%;
    }
    a {
        display: block;
        text-align: center;
        font-size: 200%;
    }
    img {
        width: 50vh;
        height: 50vh;
        margin: auto;
        display: block;
    }
</style>
<html lang="en_US">
    <head>
        <Head />
        <script src="../scripts/theme.js"></script>
    </head>
    <body>
        <Picture src={Thinker} alt="thinker" />
        <h1>Error 404</h1>
        <p>We couldn't find the page you were looking for</p>
        <a href="home">Return to Homepage</a>
    </body>
</html>
