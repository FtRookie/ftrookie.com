---
import Head from "../components/Head.astro";
import { Picture } from "astro:assets";
import { bungers } from "../scripts/bunger";
import "../styles/global.css";
---

<html lang="en">
    <head>
        <Head />
        <script src="../scripts/theme.ts"></script>
        <style>
            div {
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                padding: 5%;
            }
            h1 {
                text-align: center;
                font-size: min(5rem, 50vh);
            }
            p {
                text-align: center;
                font-size: clamp(1rem, 300%, 3rem);
                margin: auto;
            }
            a {
                text-align: center;
                margin: auto;
                font-size: clamp(1rem, 200%, 2.5rem);
                margin-top: 1rem;
            }
            img {
                width: 40vmin;
                height: auto;
                margin: auto;
            }
        </style>
    </head>
    <body>
        <div>
            <Picture src={bungers.thinker} alt="thinker" />
            <h1>Error 404</h1>
            <p>That page doesn't exist</p>
            <a href="/home">Return to Homepage</a>
        </div>
    </body>
</html>
