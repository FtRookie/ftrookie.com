---
import Head from "../components/Head.astro";
import { Picture } from "astro:assets";
import Thinker from "../media/bunger/FTRookie_think.png";
import "../styles/global.css";
---

<style>
    div {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 5%;
    }
    h1 {
        text-align: center;
        font-size: min(5rem, 50vh);
    }
    p {
        text-align: center;
        font-size: 300%;
        margin: auto;
    }
    a {
        text-align: center;
        margin: auto;
        font-size: 200%;
        margin-top: 1rem;
    }
    img {
        width: 40vmin;
        height: auto;
        margin: auto;
    }
</style>
<html lang="en_US">
    <head>
        <Head />
        <script src="../scripts/theme.js"></script>
    </head>
    <body>
        <div>
            <Picture src={Thinker} alt="thinker" />
            <h1>Error 404</h1>
            <p>We couldn't find the page you were looking for</p>
            <a href="/home">Return to Homepage</a>
        </div>
    </body>
</html>
